# Copy to app.env; replace the password to match postgres.env. Never commit app.env.
ConnectionStrings__FlightDeals=Host=db;Port=5432;Database=flight_deals;Username=flight_deals;Password=REPLACE_WITH_PROJECT_PASSWORD;GSS Encryption Mode=Disable
ASPNETCORE_ENVIRONMENT=Production
FlightDeals__LiveSearchEnabled=false
FlightDeals__SchedulerEnabled=false
# Leave empty for offline validation. Never use a real key in an image or build argument.
SERPAPI_API_KEY=
